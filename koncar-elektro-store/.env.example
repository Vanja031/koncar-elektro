# ============================================================
# Koncar Elektro Store — primer env fajla
# Kopirati u `.env` (ne commitovati) i popuniti vrednosti.
# Struktura: ZAJEDNIČKO → STAGING (aktivno) → LIVE (zakomentarisano).
# ============================================================

# --- ZAJEDNIČKO (uvek isto) ---
NEXT_PUBLIC_CANONICAL_URL=https://koncarelektro.rs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_LIVE_API=true

# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_ANALYTICS_LIVE=false

# RaiAccept — server-only (Sandbox / Production API Credentials iz Merchant portala)
# RAIACCEPT_USERNAME=
# RAIACCEPT_PASSWORD=
# RAIACCEPT_ENV=sandbox


# ============================================================
# STAGING — AKTIVNO
# ============================================================
# NEXT_PUBLIC_WP_API_URL=https://testing.cleannikki.com/wp-json
# NEXT_PUBLIC_WC_STORE_API_URL=https://testing.cleannikki.com/wp-json/wc/store/v1
# WP_REWRITE_ORIGIN=https://testing.cleannikki.com
#
# # Server-only WC REST v3 (Write) — WooCommerce → Settings → Advanced → REST API
# WC_CONSUMER_KEY=ck_...
# WC_CONSUMER_SECRET=cs_...
#
# WC_LIVE_CHECKOUT=true
# WC_CHECKOUT_FORCE_TEST_CUSTOMER=true


# ============================================================
# LIVE — zakomentarisano do go-live-a
# ============================================================
# NEXT_PUBLIC_WP_API_URL=https://koncarelektro.rs/wp-json
# NEXT_PUBLIC_WC_STORE_API_URL=https://koncarelektro.rs/wp-json/wc/store/v1
# WP_REWRITE_ORIGIN=https://koncarelektro.rs
#
# WC_CONSUMER_KEY=ck_...
# WC_CONSUMER_SECRET=cs_...
#
# WC_LIVE_CHECKOUT=true
# WC_CHECKOUT_FORCE_TEST_CUSTOMER=false
# NEXT_PUBLIC_ANALYTICS_LIVE=true
